# Copy to .env; loaded by tools/env.sh as a local shell config. Use absolute paths for overrides.
# Existing installation: uncomment and set paths to your three Python interpreters.
# GLA_PYTHON=/absolute/path/to/GLA-CLIP/bin/python
# RAG_PYTHON=/absolute/path/to/.venv-rag/bin/python
# DPO_PYTHON=/absolute/path/to/.venv-posttrain/bin/python
PORT=7860
GPU=0
RAG_RERANK_MODEL=clean_e
# GLA_RAG_HOME=/absolute/path/to/rag_data
# ABO_ROOT=/absolute/path/to/ABO
# DINO_WEIGHTS=/absolute/path/to/dino_vitbase8_pretrain.pth
# HF_HUB_CACHE=/absolute/path/to/huggingface/hub
# Fresh installation defaults match the original tested GPU runtime.
TORCH_VERSION=2.14.0
TORCHVISION_VERSION=0.29.0
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
MAX_JOBS=2
